{
  "name": "@nos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "gmail:auth": "tsx src/gmail/auth.ts",
    "gmail:sync": "tsx src/gmail/cli.ts",
    "lint": "eslint src",
    "test": "vitest run src --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run src/db/schema.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/local-auth": "2.1.0",
    "dotenv": "latest",
    "fastify": "latest",
    "googleapis": "105",
    "html-to-text": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "tsx": "latest",
    "@types/pg": "latest",
    "@types/html-to-text": "latest",
    "vitest": "latest"
  }
}
