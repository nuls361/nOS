NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_PUBLIC_ORIGIN=http://localhost:5173
APP_USER_EMAIL=niels@songpush.com
APP_PASSWORD=
SESSION_SECRET=
# Lokal: compose.yaml. Produktiv: Supabase Session-Pooler (Port 5432)
DATABASE_URL=postgres://nos:nos@localhost:5432/nos
# Nur produktiv: Transaction-Pooler (Port 6543) für Vercel-Functions
# Integrationstests laufen NIE gegen die Produktions-DB, sondern hiergegen (compose.yaml)
DATABASE_URL_TEST=postgres://nos:nos@localhost:5432/nos
DATABASE_URL_POOLED=
GMAIL_ACCOUNT_EMAIL=niels@songpush.com
# JSON mapping for internal forwards, e.g. {"Lina":"lina@songpush.com"}
TEAM_EMAILS_JSON={}
GOOGLE_OAUTH_CREDENTIALS_PATH=./secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_PATH=./secrets/google-oauth-token.json
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
ATTIO_API_KEY=
# JSON mapping from colleague names to Attio workspace-member UUIDs
ATTIO_MEMBER_IDS_JSON={}
ATTIO_API_BASE_URL=https://api.attio.com/v2
ATTIO_MEETING_LOOKBACK_HOURS=24
# Absender-Domains ohne Automatik-Header, die trotzdem Maschinen sind (kommagetrennt)
EMAIL_IGNORED_SENDER_DOMAINS=superhuman.com
