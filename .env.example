# Integrationstests laufen NIE gegen die Produktions-DB, sondern hiergegen (compose.yaml)
DATABASE_URL_TEST=postgres://nos:nos@localhost:5432/nos
DATABASE_URL_POOLED=
GMAIL_ACCOUNT_EMAIL=niels@songpush.com
GOOGLE_OAUTH_CREDENTIALS_PATH=./secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_PATH=./secrets/google-oauth-token.json
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
ATTIO_API_KEY=
ATTIO_API_BASE_URL=https://api.attio.com/v2
ATTIO_MEETING_LOOKBACK_HOURS=24
