{
  "name": "nos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @nos/server dev\" \"pnpm --filter @nos/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @nos/server test:db",
    "db:migrate": "pnpm --filter @nos/server db:migrate",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "typescript": "6.0.2",
    "typescript-eslint": "latest"
  }
}
